# Ambiente Python
venv/
__pycache__/
*.pyc

# Variabili d'ambiente (segreti: NON vanno mai su git)
.env

# Database locale (quello dei test sta fuori dal progetto, vedi conftest.py)
*.db
*.sqlite3
# Le copie di sicurezza del database: sono dati veri, non devono finire su
# GitHub nemmeno per sbaglio.
*.db.bak

# Build del frontend (la genera Render, non va su git)
frontend/dist/

# Le librerie di node NON vanno su git: le riscarica chi serve, a partire da
# package-lock.json che invece e' versionato (fissa le versioni esatte).
# Il comando di build su Render e' "npm install && npm run build", quindi se
# le ricrea da solo a ogni pubblicazione.
frontend/node_modules/

# IDE e strumenti locali
.vscode/
.idea/
.claude/
