# Copia questo file in ".env" e riempi i valori veri.
# ".env" NON va su git (contiene segreti); ".env.example" sì (è il modello).

# SQLite per iniziare (nessun server richiesto):
DATABASE_URL=sqlite:///./gestione_lavori.db

# Quando passerai a PostgreSQL, sarà qualcosa tipo:
# DATABASE_URL=postgresql://utente:password@localhost:5432/gestione_lavori
